# ==============================================================================
# CHEFU ACCOUNT (CheFu-Account) ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# ── Public App & Service URLs ──
NEXT_PUBLIC_API_BASE_URL=https://api.chefu.co.za
NEXT_PUBLIC_ACCOUNT_APP_URL=https://myaccount.chefu.co.za
# Set to true only for local UI previewing. It is ignored by production builds.
NEXT_PUBLIC_DEV_PREVIEW=false

# ── Firebase Client SDK (Public Client-side Configuration) ──
# Required in production: The app will flag if dummy development values are left in production.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_firebase_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_firebase_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=1:your_firebase_project_number:web:your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
