# ==============================================================================
# CHEFU ACCOUNT (CheFu-Account) ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# ── Public App & Service URLs ──
NEXT_PUBLIC_API_BASE_URL=https://api.chefu.co.za
NEXT_PUBLIC_ACCOUNT_APP_URL=https://myaccount.chefu.co.za
# Set to true only for local UI previewing. It is ignored by production builds.
NEXT_PUBLIC_DEV_PREVIEW=false
